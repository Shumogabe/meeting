{
  "name": "vn.gov.monre.meeting",
  "version": "1.0.0",
  "private": true,
  "description": "Ionic Angular Capacitor",
  "homepage": "https://meeting.monre.gov.vn",
  "author": {
    "name": "Middle Kien",
    "email": "haki.kiennt@gmail.com"
  },
  "scripts": {
    "build": "ng build --configuration production",
    "build-capacitor-hybrid-vnptid": "cd projects/capacitor-hybrid-vnptid && npm install && npm run build",
    "build-web": "ionic build --prod && npm run minify-html && cp -R www www.monre/",
    "fmt": "ng lint --fix && npm run prettier -- --write",
    "preinstall": "npm i -g @ionic/cli@7 && npm run install-capacitor-hybrid-vnptid",
    "install-capacitor-hybrid-vnptid": "npm run build-capacitor-hybrid-vnptid && npm install capacitor-hybrid-vnptid@file:./projects/capacitor-hybrid-vnptid",
    "lint": "ng lint && npm run prettier -- --check",
    "minify-html": "html-minifier-terser --collapse-whitespace --remove-comments --remove-optional-tags --minify-css true --minify-js true www/index.html -o www/index.html",
    "ng": "ng",
    "open-android": "npx cap open android",
    "open-ios": "npx cap open ios",
    "prettier": "prettier \"{src,e2e/src}/**/*.{css,scss,html,ts,js}\"",
    "serve": "ionic serve --port=8200",
    "serve-ssl": "sudo ionic serve --port=443 --ssl --no-open --external",
    "start": "ng serve",
    "sync": "ionic build --prod && npx cap sync",
    "sync-android": "ionic build --prod && npx cap sync android",
    "sync-ios": "ionic build --prod && npx cap sync ios",
    "test": "ng test",
    "test:ci": "ng test --watch=false --progress=false --code-coverage --browsers=HeadlessChrome"
  },
  "browserslist": [
    "Chrome >=79",
    "ChromeAndroid >=79",
    "Firefox >=70",
    "Edge >=79",
    "Safari >=14",
    "iOS >=14"
  ],
  "dependencies": {
    "axios": "1.7.2",
    "bootstrap": "^4.0.0",
    "capacitor-hybrid-vnptid": "file:projects/capacitor-hybrid-vnptid",
    "capacitor-native-settings": "6.0.1",
    "downloadjs": "^1.4.7",
    "html-minifier-terser": "^7.2.0",
    "html-to-image": "1.11.11",
    "ionicons": "7.4.0",
    "jquery": "^3.0.0",
    "localforage": "1.10.0",
    "moment": "2.30.1",
    "ng-otp-input": "1.9.3",
    "ngx-image-cropper": "8.0.0",
    "path-browserify": "1.0.1",
    "rxjs": "7.8.1",
    "safe-pipe": "2.0.5",
    "svg-captcha-browser": "1.0.2",
    "swiper": "^8.0.0",
    "tslib": "2.6.2",
    "zone.js": "^0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular-eslint/builder": "^17.0.0",
    "@angular-eslint/eslint-plugin": "^17.0.0",
    "@angular-eslint/eslint-plugin-template": "^17.0.0",
    "@angular-eslint/template-parser": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/language-service": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "@angular/service-worker": "^17.0.0",
    "@capacitor-community/speech-recognition": "^6.0.1",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/app-launcher": "^6.0.0",
    "@capacitor/assets": "^3.0.0",
    "@capacitor/browser": "^6.0.0",
    "@capacitor/camera": "^6.0.1",
    "@capacitor/cli": "^6.0.0",
    "@capacitor/clipboard": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@capacitor/device": "^6.0.0",
    "@capacitor/filesystem": "^6.0.0",
    "@capacitor/geolocation": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/ios": "^6.0.0",
    "@capacitor/keyboard": "^6.0.0",
    "@capacitor/network": "^6.0.0",
    "@capacitor/push-notifications": "^6.0.0",
    "@capacitor/share": "^6.0.0",
    "@capacitor/splash-screen": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0",
    "@capawesome/capacitor-file-picker": "^6.0.0",
